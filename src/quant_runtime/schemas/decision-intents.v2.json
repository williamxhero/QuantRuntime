{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research.local/schemas/decision-intents.v2.json",
  "title": "Canonical Decision Intents v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "strategy_package_hash", "snapshot_id", "intents"],
  "properties": {
    "schema": {"const": "quant-research.decision-intents.v2"},
    "strategy_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intents": {"type": "array", "items": {"oneOf": [
      {"$ref": "#/$defs/target_weight"}, {"$ref": "#/$defs/target_position"}, {"$ref": "#/$defs/target_contracts"},
      {"$ref": "#/$defs/target_notional"}, {"$ref": "#/$defs/order"}, {"$ref": "#/$defs/cancel"}, {"$ref": "#/$defs/spread"}
    ]}}
  },
  "$defs": {
    "base": {"type": "object", "required": ["type", "instrument", "decision_time"], "properties": {"type": {"type": "string"}, "instrument": {"type": "string", "minLength": 1}, "decision_time": {"type": "string", "format": "date-time"}}},
    "target_weight": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["target_weight"], "properties": {"type": {"const": "target_weight"}, "target_weight": {"type": "number", "minimum": -1, "maximum": 1}}, "unevaluatedProperties": false}]},
    "target_position": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["target_position"], "properties": {"type": {"const": "target_position"}, "target_position": {"type": "number"}}, "unevaluatedProperties": false}]},
    "target_contracts": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["target_contracts"], "properties": {"type": {"const": "target_contracts"}, "target_contracts": {"type": "integer"}}, "unevaluatedProperties": false}]},
    "target_notional": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["target_notional", "currency"], "properties": {"type": {"const": "target_notional"}, "target_notional": {"type": "number"}, "currency": {"type": "string"}}, "unevaluatedProperties": false}]},
    "order": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["side", "quantity", "order_type"], "properties": {"type": {"const": "order"}, "side": {"enum": ["buy", "sell"]}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "order_type": {"enum": ["market", "limit", "stop"]}, "limit_price": {"type": "number"}, "stop_price": {"type": "number"}}, "unevaluatedProperties": false}]},
    "cancel": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["client_order_id"], "properties": {"type": {"const": "cancel"}, "client_order_id": {"type": "string"}}, "unevaluatedProperties": false}]},
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "decision_time", "legs"],
      "properties": {
        "type": {"const": "spread"},
        "decision_time": {"type": "string", "format": "date-time"},
        "legs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instrument", "contracts"],
            "properties": {
              "instrument": {"type": "string"},
              "contracts": {"type": "integer", "not": {"const": 0}}
            }
          }
        }
      }
    }
  }
}
