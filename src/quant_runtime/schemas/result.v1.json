{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research.local/schemas/result.v1.json",
  "title": "Canonical Workspace Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "formal_results", "comparison", "warnings", "incomparable"],
  "properties": {
    "schema": {"const": "quant-research.result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "rejected"]},
    "formal_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/formal"}},
    "comparison": {"type": ["object", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "incomparable": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "formal": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_id", "adapter_version", "engine_version", "status", "metrics", "native_evidence"],
      "properties": {
        "backend_id": {"type": "string"}, "adapter_version": {"type": "string"}, "engine_version": {"type": "string"},
        "status": {"enum": ["completed", "failed", "rejected"]}, "metrics": {"type": "object"},
        "positions": {"type": "array"}, "fills": {"type": "array"}, "account_curve": {"type": "array"},
        "native_evidence": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
