{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research.local/schemas/strategy-package.v1.json",
  "title": "Strategy Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "strategy_id", "revision", "display_name", "parameter_schema", "pipeline", "requirements", "implementations", "dependencies"],
  "properties": {
    "schema": {"const": "quant-research.strategy-package.v1"},
    "strategy_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1},
    "parameter_schema": {"type": "string", "minLength": 1},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "formal"],
      "properties": {
        "discovery": {"enum": ["required", "optional", "forbidden"]},
        "formal": {"const": "required"}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_classes", "frequencies", "capabilities", "decision_intents"],
      "properties": {
        "asset_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frequencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}},
        "decision_intents": {"type": "array", "uniqueItems": true, "items": {"enum": ["target_weight", "target_position", "target_contracts", "target_notional", "order", "cancel", "spread"]}}
      }
    },
    "implementations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal"],
      "properties": {
        "discovery": {"$ref": "#/$defs/implementations"},
        "formal": {"$ref": "#/$defs/implementations"}
      }
    },
    "dependencies": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "implementations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
